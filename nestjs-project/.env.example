# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@streamtube.com

# Phase 03 video infrastructure. Replace these local example credentials in .env.
MINIO_ROOT_USER=streamtube-local-admin
MINIO_ROOT_PASSWORD=replace-this-local-admin-password
S3_API_ACCESS_KEY=streamtube-api
S3_API_SECRET_KEY=replace-this-local-api-secret
S3_WORKER_ACCESS_KEY=streamtube-worker
S3_WORKER_SECRET_KEY=replace-this-local-worker-secret
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_CORS_ALLOWED_ORIGIN=http://localhost:3000
S3_ORIGINALS_BUCKET=videos-originals
S3_THUMBNAILS_BUCKET=videos-thumbnails
REDIS_HOST=redis
REDIS_PORT=6379
VIDEO_MAX_BYTES=10000000000
VIDEO_PART_BYTES=16777216
VIDEO_UPLOAD_TTL_SECONDS=86400
VIDEO_PRESIGN_TTL_SECONDS=900
VIDEO_WORKER_CONCURRENCY=1
VIDEO_TEMP_DIR=/tmp/video-processing
VIDEO_TEMP_MIN_FREE_BYTES=12884901888
VIDEO_JOB_TIMEOUT_MS=7200000
VIDEO_FFPROBE_TIMEOUT_MS=60000
VIDEO_FFMPEG_TIMEOUT_MS=120000
VIDEO_DISPATCH_INTERVAL_MS=30000

FROM node:25.6.0-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg=7:5.1.9-0+deb12u1 curl procps && rm -rf /var/lib/apt/lists/*
WORKDIR /home/node/app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig*.json ./
COPY src ./src
COPY scripts ./scripts
RUN chmod +x scripts/start-video-worker.sh
RUN mkdir -p /tmp/video-processing && chown -R node:node /tmp/video-processing
USER node
